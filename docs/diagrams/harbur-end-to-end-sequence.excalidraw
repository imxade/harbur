			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "High-frequency thread mutations write UUID append files, avoiding shared repo-index rewrites; no queue, lock service, or DB transaction.\nCompaction folds appends into per-thread docs + index.\nSettings, watches, cleanup, merge, backup status, users, notifications, and manifests use versioned mutable JSON saves.\nName changes update users[email] and remap owned repo ids; stored comments/thread text remain email-keyed.",
			"fontSize": 20,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "High-frequency thread mutations write UUID append files, avoiding shared repo-index rewrites; no queue, lock service, or DB transaction.\nCompaction folds appends into per-thread docs + index.\nSettings, watches, cleanup, merge, backup status, users, notifications, and manifests use versioned mutable JSON saves.\nName changes update users[email] and remap owned repo ids; stored comments/thread text remain email-keyed.",
			"lineHeight": 1.25,
			"baseline": 16
		},
