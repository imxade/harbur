			"versionNonce": 2532,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Keep Google SSO + Harbur HttpOnly sessions, owner Drive credentials server-only, one immutable content ZIP per repo version plus\ncurrent index/thread JSON, optimistic versions/ETags, public reads as unauthenticated server functions that return public data only,\nprivate/user indexes uncached, every mutation server-validated before Drive writes.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Keep Google SSO + Harbur HttpOnly sessions, owner Drive credentials server-only, one immutable content ZIP per repo version plus\ncurrent index/thread JSON, optimistic versions/ETags, public reads as unauthenticated server functions that return public data only,\nprivate/user indexes uncached, every mutation server-validated before Drive writes.",
			"lineHeight": 1.25,
			"baseline": 12
		},
