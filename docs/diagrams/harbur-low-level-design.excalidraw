			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Repository ZIP bytes load into the browser through\ntemporary Drive copies for PR creation, merge,\npre-merge preview, full-file operations,\nand direct ZIP download; archive work stays client-side.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Repository ZIP bytes load into the browser through\ntemporary Drive copies for PR creation, merge,\npre-merge preview, full-file operations,\nand direct ZIP download; archive work stays client-side.",
			"lineHeight": 1.25,
			"baseline": 12
		},
