			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "No Google secret leaves backend. Owner token is server env. Backup tokens stay in\nprimary appData. Returned AppState is filtered and credentials stripped.",
