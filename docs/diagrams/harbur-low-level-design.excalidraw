		{
			"id": "text-501",
			"type": "text",
			"x": 170,
			"y": 4474,
			"width": 720,
			"height": 56.25,
			"angle": 0,
			"strokeColor": "#475569",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
