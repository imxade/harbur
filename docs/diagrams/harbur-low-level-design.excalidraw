			"locked": false,
			"text": "Reason: one small global read plus targeted repo reads\nkeeps Drive latency bounded.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Reason: one small global read plus targeted repo reads\nkeeps Drive latency bounded.",
