		{
			"id": "text-531",
			"type": "text",
			"x": 5150,
			"y": 4474,
			"width": 1120,
			"height": 56.25,
			"angle": 0,
			"strokeColor": "#475569",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
