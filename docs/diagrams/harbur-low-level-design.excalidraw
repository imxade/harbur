			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Drive REST metadata/media load for JSON; JSON create/update\nby name via metadata lookup before PATCH.\nexpectedVersion conflicts; resumable upload session\nwith Origin/content length/type.\nTemporary ZIP download copy fetched via Drive API media;\nsigned cleanup waits configured delay.\nDrive-to-Drive ZIP backup copy; 429/5xx retries;\n404 delete treated as gone.",
			"fontSize": 16,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Drive REST metadata/media load for JSON; JSON create/update\nby name via metadata lookup before PATCH.\nexpectedVersion conflicts; resumable upload session\nwith Origin/content length/type.\nTemporary ZIP download copy fetched via Drive API media;\nsigned cleanup waits configured delay.\nDrive-to-Drive ZIP backup copy; 429/5xx retries;\n404 delete treated as gone.",
			"lineHeight": 1.25,
			"baseline": 13
		},
