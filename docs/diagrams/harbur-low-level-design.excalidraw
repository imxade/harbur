			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Reason: large upload bytes bypass serverless request-body limits; committed-download bytes come from temporary\nDrive API media copies while server still owns authorization and final commit.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Reason: large upload bytes bypass serverless request-body limits; committed-download bytes come from temporary\nDrive API media copies while server still owns authorization and final commit.",
			"lineHeight": 1.25,
			"baseline": 12
		},
