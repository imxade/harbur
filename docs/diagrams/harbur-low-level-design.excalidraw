			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Metadata split by hotness: global shell, per-repo index, per-thread detail, append\nrecords, repository ZIP, PR ZIP. No per-file Drive writes. No app-level serialization\nqueue.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Metadata split by hotness: global shell, per-repo index, per-thread detail, append\nrecords, repository ZIP, PR ZIP. No per-file Drive writes. No app-level serialization\nqueue.",
			"lineHeight": 1.25,
			"baseline": 12
		},
