			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "High-frequency thread mutations create separate append JSON files.\nThey avoid shared repo-index rewrites.\nLater repository loads compact appends into per-thread docs\nand the per-repo index.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "High-frequency thread mutations create separate append JSON files.\nThey avoid shared repo-index rewrites.\nLater repository loads compact appends into per-thread docs\nand the per-repo index.",
			"lineHeight": 1.25,
			"baseline": 12
		},
