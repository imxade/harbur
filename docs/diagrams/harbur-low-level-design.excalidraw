			"baseline": 16
		},
		{
			"id": "text-441",
			"type": "text",
			"x": 1620,
			"y": 3709,
			"width": 1320,
			"height": 37.5,
			"angle": 0,
			"strokeColor": "#475569",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"roundness": {
				"type": 3
			},
			"seed": 1442,
			"version": 1,
			"versionNonce": 2442,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Client validates for immediate UX; server remains authoritative. README/assets sidecars are capped and verified by hash; repository exports exclude Harbur\nmetadata folders such as issues/, pulls/, activity/, feeds/, audit/, settings/, credentials/.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Client validates for immediate UX; server remains authoritative. README/assets sidecars are capped and verified by hash; repository exports exclude Harbur\nmetadata folders such as issues/, pulls/, activity/, feeds/, audit/, settings/, credentials/.",
			"lineHeight": 1.25,
			"baseline": 12
		},
