			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "The current design favors one global manifest plus per-repo indexes.\nExtra public/user indexes would add repair and consistency paths.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The current design favors one global manifest plus per-repo indexes.\nExtra public/user indexes would add repair and consistency paths.",
