			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Shared client ZIP workflow: normalizes folder paths,\nstrips common root, excludes VCS metadata,\napplies root .gitignore for local folders,\nfetches GitHub API/raw files,\ncomputes PR diffs/merge ZIPs,\nchecks quota and PUTs bytes to Drive upload URL.",
			"fontSize": 16,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Shared client ZIP workflow: normalizes folder paths,\nstrips common root, excludes VCS metadata,\napplies root .gitignore for local folders,\nfetches GitHub API/raw files,\ncomputes PR diffs/merge ZIPs,\nchecks quota and PUTs bytes to Drive upload URL.",
			"lineHeight": 1.25,
			"baseline": 13
		},
