			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Shell reads one small global doc. Repo operations read one repo index plus appends.\nRoute-scoped merge avoids full app-state reload. Server access-token memoization is\nshort-lived and server-only.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Shell reads one small global doc. Repo operations read one repo index plus appends.\nRoute-scoped merge avoids full app-state reload. Server access-token memoization is\nshort-lived and server-only.",
			"lineHeight": 1.25,
			"baseline": 12
		},
