		{
			"id": "text-436",
			"type": "text",
			"x": 160,
			"y": 3709,
			"width": 1280,
			"height": 75,
			"angle": 0,
			"strokeColor": "#475569",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"roundness": {
				"type": 3
			},
			"seed": 1437,
			"version": 1,
			"versionNonce": 2437,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "When enabled in admin settings, browser reads GitHub API tree data,\nfetches raw/blob file bytes without .gitignore, uploads through a signed\nstaged Drive session, and refreshes only during admin sessions when due.\nNormal public/user reads never fetch GitHub.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "When enabled in admin settings, browser reads GitHub API tree data,\nfetches raw/blob file bytes without .gitignore, uploads through a signed\nstaged Drive session, and refreshes only during admin sessions when due.\nNormal public/user reads never fetch GitHub.",
			"lineHeight": 1.25,
			"baseline": 12
		},
