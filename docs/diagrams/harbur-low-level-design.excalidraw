			"link": null,
			"locked": false,
			"text": "Every response is actor-scoped: private repos and detail maps are removed for unauthorized actors, stale notifications are filtered, users are\nlimited to visible collaboration context, and backupCredentials are stripped.",
			"fontSize": 17,
			"fontFamily": 2,
			"textAlign": "left",
