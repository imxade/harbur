				"type": 3
			},
			"seed": 1502,
			"version": 1,
			"versionNonce": 2502,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1,
			"link": null,
			"locked": false,
			"text": "Google Drive has higher latency than DB/object storage, versioned files instead of\ntransactions, API quota, and transient 429/5xx risk. Harbur keeps deployment simple:\nstateless serverless + Drive only.",
			"fontSize": 15,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Google Drive has higher latency than DB/object storage, versioned files instead of\ntransactions, API quota, and transient 429/5xx risk. Harbur keeps deployment simple:\nstateless serverless + Drive only.",
			"lineHeight": 1.25,
			"baseline": 12
		},
