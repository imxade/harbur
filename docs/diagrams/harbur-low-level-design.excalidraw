			"link": null,
			"locked": false,
			"text": "Upload limits and sidecar policy",
			"fontSize": 20,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Upload limits and sidecar policy",
