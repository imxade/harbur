{
	"name": "harbur",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"predev": "npm run format && npm run diagrams:build",
		"dev": "vite dev --port 3000",
