		"fflate": "^0.8.2",
		"ignore": "^7.0.6",
		"katex": "^0.18.4",
		"lucide-react": "^0.545.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
